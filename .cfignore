node_modules/

# --- Not served by the site; excluded to stay under the Pages 20,000-file limit ---
# The deployment was measured at ~20,944 files on 2026-08-03, i.e. over the ceiling.
#
# Root election-viewer-package/ is the pre-app copy of the standalone viewer. Its only
# consumer is js/election-controller.js, which no HTML file loads (the js/ Leaflet stack
# is dead legacy). The live site loads app/election-viewer-package/ instead -- six CSS/JS
# files, no data directory -- so the leading slash below is load-bearing: unanchored,
# this pattern would match the app copy too and take the election viewer's styles with it.
/election-viewer-package/

# Working analysis, not site content.
analysis/

# Pipeline inputs: alignment CSVs, corrections and official-result sources consumed by
# scripts at build time. Nothing under app/src or test/src fetches them.
data/elections/

# Card thumbnail images are served from R2 (https://data.civgraph.net/assets/thumbnails/)
# via js/cdn-url.js. They stay in git as the source of truth; they just do not need to
# occupy 1,793 of the Pages file budget to be delivered.
#
# Only the images are excluded. manifest.json stays in the deploy because
# build-shared-shell-assets.mjs regenerates it from this directory on every build --
# serving it from R2 as well would let the list and the images drift apart.
#
# After adding or re-rendering a thumbnail, run: npm run sync:thumbnails
# (idempotent; it skips objects already present).
assets/thumbnails/*.webp
assets/thumbnails/*.png

# R2 publication allowlist — governs what may be written to the public bucket.
# Operational config, not site content: publishing it would hand out a map of
# the bucket's prefix layout for no benefit to any reader.
data/database/r2-publication-allowlist.json
