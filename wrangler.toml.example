# Cloudflare Pages configuration for civgraph — TEMPLATE, NOT ACTIVE
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE RENAMING THE FILE
# ---------------------------------------------------------------------------
#
# This is deliberately `wrangler.toml.example` and not `wrangler.toml`.
#
# Cloudflare Pages treats a committed `wrangler.toml` as AUTHORITATIVE. The
# moment one exists, the bindings configured in the dashboard are ignored and
# only what is declared here is bound. Any binding missing from this file
# disappears from production, and the Functions that depend on it start
# answering `503 … binding not configured`.
#
# UPDATE 2026-08-11: the project's production bindings were read back from the
# Pages API and are reproduced below IN FULL. There are exactly five, and this
# file now matches them, so the "might silently drop a binding" risk is resolved.
# The project has NO environment variables set at all.
#
# TO ACTIVATE:
#   1. Deploy to a PREVIEW branch first and exercise /_api/proni/search,
#      /_api/elections/, /_api/spatial, /_api/search and a data/maps/* URL.
#      Preview uses its own binding set — declare it too, or accept that preview
#      Functions will 503 while production is unaffected.
#   2. Confirm nothing has been added in the dashboard since the date above.
#   3. Only then rename to `wrangler.toml` and merge.
#
# There is no urgency. The dashboard configuration works, and adopting this file
# buys version control over five bindings at the cost of a new way to break
# production. Do it when the deployment is otherwise quiet.
#
# Do NOT put CIVGRAPH_ADMINS or CIVGRAPH_CONTRIBUTORS in a committed file. They
# are email addresses, this repository is public and MIT-licensed, and committing
# them would publish personal data. Keep them as dashboard variables, or set them
# as secrets.
#
# ---------------------------------------------------------------------------

name = "civgraph"

# MUST match what production already runs. The project is on 2026-04-04 with no
# compatibility flags. Bumping this date changes Workers runtime behaviour, so
# it is a deliberate change to make on its own, never a side effect of adopting
# this file.
compatibility_date = "2026-04-04"

# The site is served from the repository root — index.html, 404.html and
# _headers all live at the top level, and `.cfignore` excludes archival
# material from the upload.
pages_build_output_dir = "."

# The build command, read from the project on 2026-08-11:
#
#     npm install --ignore-scripts && npm run build && bash scripts/clean-for-pages.sh
#
# `wrangler.toml` does not carry the build command for Pages — it stays a
# project setting. It is recorded here because it is otherwise invisible from
# the repository, and because `clean-for-pages.sh` trimming the output below
# Cloudflare's 20,000-file limit is load-bearing and easy to miss.
#
# root_dir and destination_dir are both empty, i.e. the repository root.


# --- D1 -------------------------------------------------------------------
# Verified against the account on 2026-08-11 via `wrangler d1 list`.

[[d1_databases]]
binding = "PRONI_DB"
database_name = "proni-catalogue"
database_id = "a66d0846-6186-460d-a7b2-e88918a6b341"

[[d1_databases]]
binding = "ELECTIONS_DB"
database_name = "civgraph-elections"
database_id = "cd88f241-35aa-4cbb-bcb3-c80a471b8afa"


# --- KV -------------------------------------------------------------------
# Verified via `wrangler kv namespace list`. Only these two namespaces exist
# on the account.

[[kv_namespaces]]
binding = "PRONI_KV"
id = "ef19e1065f854619a19e2cbd62b28f82"

[[kv_namespaces]]
binding = "SPATIAL_INDEX"
id = "c88a99b42d6d4ce7aba6ba94dce47e5a"


# --- R2 -------------------------------------------------------------------
# Verified via `wrangler r2 bucket list`. `boundaries-data` is the only bucket
# on the account. It is also served publicly at data.civgraph.net.

[[r2_buckets]]
binding = "MAPS_BUCKET"
bucket_name = "boundaries-data"


# --- UNVERIFIED -----------------------------------------------------------
#
# `functions/_api/contributions/submit.js` reads, in order:
#     env.CIVGRAPH_CONTRIBUTION_QUEUE   (.put — KV)
#     env.CONTRIBUTION_QUEUE            (.put — KV)
#     env.CIVGRAPH_SUBMISSIONS          (.put with httpMetadata — R2)
# and returns 503 if none is present.
#
# SETTLED 2026-08-11: the Pages API reports exactly five production bindings —
# ELECTIONS_DB, PRONI_DB, PRONI_KV, SPATIAL_INDEX, MAPS_BUCKET — and no others.
# None of the three submission names is bound, so the contribution submission
# path is NOT wired up: every POST reaches the 503.
#
# Activating this file does not make that worse; it is already the live state.
# To make submissions work, create the resource and declare it here:
#
# [[kv_namespaces]]
# binding = "CIVGRAPH_CONTRIBUTION_QUEUE"
# id = "…"
#
# [[r2_buckets]]
# binding = "CIVGRAPH_SUBMISSIONS"
# bucket_name = "…"


# --- Variables ------------------------------------------------------------
# The project currently has NO environment variables set, so CIVGRAPH_ADMINS and
# CIVGRAPH_CONTRIBUTORS are both unset. In _auth.js that is fail-open on the
# allowlist: `allowlistConfigured` is false, so ANY authenticated caller is
# treated as an approved contributor. Nobody can currently authenticate — the
# email comes from Cloudflare Access headers and Access is not in front of the
# app — but the moment Access is enabled, every user it admits becomes a
# contributor until an allowlist exists. Set CIVGRAPH_ADMINS at minimum, in the
# same change that enables Access.
#
# Do NOT declare them here: they are email addresses and this repository is
# public. Keep them as dashboard variables, or set them as secrets.
#
# CIVGRAPH_DEV_AUTH_EMAIL bypasses Access entirely by supplying the email
# directly. It is a local-development override and must never be set in
# production.
#
# _auth.js and submit.js each accept their binding under three names
# (CIVGRAPH_*, CONTRIBUTOR_*/CONTRIBUTION_*, and BROWSE_*). That is legacy
# tolerance left over from renames, not three separate bindings. Configure the
# CIVGRAPH_* form; the others are fallbacks.
